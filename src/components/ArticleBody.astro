---
import RichText from './RichText.astro';
import Notice from './openvue/Notice.vue';
import { headingId } from '../data/articles.js';

const { blocks } = Astro.props;
---

{
    blocks.map((block) => {
        if (block.t === 'h2') {
            return <h2 id={headingId(block.text)}>{block.text}</h2>;
        }

        if (block.t === 'ul') {
            return (
                <ul>
                    {block.items.map((item) =>
                        typeof item === 'string' ? (
                            <li>
                                <RichText text={item} />
                            </li>
                        ) : (
                            <li>
                                <strong>{item.title}.</strong>{' '}<RichText text={item.text} />
                            </li>
                        )
                    )}
                </ul>
            );
        }

        if (block.t === 'code') {
            if (block.lang === 'diff') {
                return (
                    <pre class="code-diff"><code>{block.code.split('\n').map((line, i) => (
                        <span
                            class={
                                line.startsWith('+')
                                    ? 'diff-add'
                                    : line.startsWith('-')
                                      ? 'diff-del'
                                      : undefined
                            }
                        >
                            {i > 0 && '\n'}{line}
                        </span>
                    ))}</code></pre>
                );
            }

            return <pre><code>{block.code}</code></pre>;
        }

        if (block.t === 'figure') {
            const picture = (
                <img
                    src={block.src}
                    alt={block.alt}
                    width={block.width}
                    height={block.height}
                    loading="lazy"
                    decoding="async"
                />
            );

            return (
                <figure class="article-figure">
                    {block.href ? (
                        <a href={block.href} rel="noopener">
                            {picture}
                        </a>
                    ) : (
                        picture
                    )}
                    {block.caption && (
                        <figcaption>
                            <RichText text={block.caption} />
                        </figcaption>
                    )}
                </figure>
            );
        }

        if (block.t === 'note') {
            return (
                <div class="article-note">
                    <Notice severity="secondary">
                        <RichText text={block.text} />
                    </Notice>
                </div>
            );
        }

        return (
            <p>
                <RichText text={block.text} />
            </p>
        );
    })
}

---
import { kindLabels, formatDate, readingTime } from '../data/articles.js';
import Icon from './Icon.astro';

const { items, heading = 'h2', compact = false } = Astro.props;
const Heading = heading;
---

<ul class:list={['card-grid', !compact && 'card-grid-2']}>
    {
        items.map((article) => (
            <li>
                <article class="card card-linked article-card">
                    <p class="article-card-meta">
                        <span>{kindLabels[article.kind].label}</span>
                        <span aria-hidden="true">·</span>
                        <time datetime={article.date}>{formatDate(article.date)}</time>
                        {!compact && (
                            <>
                                <span aria-hidden="true">·</span>
                                <span>{readingTime(article)} min read</span>
                            </>
                        )}
                    </p>
                    <Heading class="card-title article-card-title">
                        <a href={`/articles/${article.slug}`}>{article.title}</a>
                    </Heading>
                    {!compact && <p class="card-body">{article.summary}</p>}
                    <p class="card-foot">
                        <span class="card-more" aria-hidden="true">
                            Read <Icon name="arrow-right" />
                        </span>
                        {!compact && (
                            <a href={article.source.url} rel="noopener">
                                {article.kind === 'discussion' ? 'Thread' : 'Original'} on{' '}
                                {article.source.short}
                            </a>
                        )}
                    </p>
                </article>
            </li>
        ))
    }
</ul>

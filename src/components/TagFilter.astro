---
/**
 * The topic bar over the article list. Plain links to static tag pages rather
 * than a client-side filter: it works without JavaScript, every filtered view
 * has a URL you can share, and the list underneath is the same server-rendered
 * registry either way.
 *
 * `current` is the active tag's slug, or nothing on the unfiltered list.
 */
import { tags, articles } from '../data/articles.js';

const { current } = Astro.props;
---

<nav class="tag-filter" aria-label="Filter articles by topic">
    <a href="/articles" aria-current={current ? undefined : 'page'}>
        All <span class="tag-count">{articles.length}</span>
    </a>
    {
        tags.map((tag) => (
            <a
                href={`/articles/tag/${tag.slug}`}
                aria-current={tag.slug === current ? 'page' : undefined}
            >
                {tag.name} <span class="tag-count">{tag.articles.length}</span>
            </a>
        ))
    }
</nav>

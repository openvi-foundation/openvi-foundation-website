---
import '../styles/openvue.generated.css';
import '../styles/global.css';
import { site, nav } from '../data/site.js';
import Icon from '../components/Icon.astro';
import Logo from '../components/Logo.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import IconLinkButton from '../components/openvue/IconLinkButton.vue';
import LinkButton from '../components/openvue/LinkButton.vue';
import Analytics from '@vercel/analytics/astro';
import { statSources } from '../data/stats.js';

const {
    title,
    description = site.description,
    schema = [],
    image = '/og.png',
    noindex = false,
    breadcrumbs = [],
    pageType = 'WebPage'
} = Astro.props;

const pageTitle = title ? `${title} | ${site.name}` : `${site.name} | ${site.seoTagline}`;

const path =
    Astro.url.pathname
        .replace(/\.html$/, '')
        .replace(/\/index$/, '')
        .replace(/\/$/, '') || '/';
const canonical = new URL(path, site.url).href;
const ogImage = new URL(image, site.url).href;

const organization = {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': `${site.url}/#organization`,
    name: site.name,
    alternateName: ['OpenVi', 'OpenVi Foundation'],
    url: site.url,
    email: site.email,
    description: site.description,
    slogan: site.tagline,
    logo: {
        '@type': 'ImageObject',
        url: new URL('/logo.svg', site.url).href,
        caption: site.name
    },
    knowsAbout: [
        'PrimeVue',
        'Vue.js component libraries',
        'Nuxt',
        'UI component libraries',
        'Design tokens and theming',
        'Open source software maintenance'
    ],
    contactPoint: {
        '@type': 'ContactPoint',
        contactType: 'technical support',
        email: site.email,
        url: site.discord
    },
    sameAs: [site.github, site.npm, site.discord]
};

const website = {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${site.url}/#website`,
    name: site.name,
    alternateName: 'OpenVi',
    url: site.url,
    description: site.description,
    inLanguage: 'en',
    publisher: { '@id': `${site.url}/#organization` }
};

const webPage = {
    '@context': 'https://schema.org',
    '@type': pageType,
    '@id': `${canonical}#webpage`,
    url: canonical,
    name: pageTitle,
    description,
    inLanguage: 'en',
    isPartOf: { '@id': `${site.url}/#website` },
    about: { '@id': `${site.url}/#organization` },
    primaryImageOfPage: { '@type': 'ImageObject', url: ogImage }
};

const trail = [{ name: 'Home', path: '/' }, ...breadcrumbs];
const breadcrumbList =
    breadcrumbs.length > 0
        ? {
              '@context': 'https://schema.org',
              '@type': 'BreadcrumbList',
              '@id': `${canonical}#breadcrumb`,
              itemListElement: trail.map((crumb, i) => ({
                  '@type': 'ListItem',
                  position: i + 1,
                  name: crumb.name,
                  item: new URL(crumb.path, site.url).href
              }))
          }
        : null;

const year = new Date().getFullYear();
---

<html lang="en" data-theme="light">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{pageTitle}</title>
        <meta name="description" content={description} />
        <link rel="canonical" href={canonical} />
        <link rel="sitemap" href="/sitemap-index.xml" />
        <meta
            name="robots"
            content={
                noindex
                    ? 'noindex, follow'
                    : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'
            }
        />

        <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
        <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
        <meta name="theme-color" content="#0f1215" media="(prefers-color-scheme: dark)" />

        <meta property="og:type" content="website" />
        <meta property="og:site_name" content={site.name} />
        <meta property="og:locale" content="en_US" />
        <meta property="og:title" content={pageTitle} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical} />
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:type" content="image/png" />
        <meta property="og:image:alt" content={pageTitle} />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={pageTitle} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImage} />

        <script is:inline>
            try {
                var stored = localStorage.getItem('theme');
                document.documentElement.dataset.theme = stored === 'dark' ? 'dark' : 'light';
            } catch (e) {
                document.documentElement.dataset.theme = 'light';
            }
        </script>

        <script is:inline>
            (function () {
                function sync() {
                    var header = document.querySelector('.site-header-over');
                    if (!header) return;
                    var y = window.scrollY || document.documentElement.scrollTop || 0;
                    header.classList.toggle('is-scrolled', y > 8);
                }

                addEventListener('scroll', sync, { passive: true });
                addEventListener('resize', sync);
                addEventListener('DOMContentLoaded', sync);
                addEventListener('load', sync);
                sync();
            })();
        </script>

        <script type="application/ld+json" set:html={JSON.stringify(organization)} />
        <script type="application/ld+json" set:html={JSON.stringify(website)} />
        <script type="application/ld+json" set:html={JSON.stringify(webPage)} />
        {
            breadcrumbList && (
                <script type="application/ld+json" set:html={JSON.stringify(breadcrumbList)} />
            )
        }
        {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
    </head>

    <body>
        <header class="site-header site-header-over">
            <div class="wrap">
                <a class="brand" href="/">
                    <Logo />
                    <span class="brand-name">OpenVi Foundation</span>
                </a>

                <input
                    class="nav-toggle-input"
                    type="checkbox"
                    id="nav-toggle"
                    aria-label="Toggle navigation menu"
                />
                <label class="nav-toggle" for="nav-toggle">
                    <span class="nav-toggle-bars" aria-hidden="true"></span>
                    <span class="visually-hidden">Menu</span>
                </label>

                <div class="primary-nav">
                    <nav class="nav-links" aria-label="Primary">
                        {
                            nav.map((item) => (
                                <LinkButton
                                    href={item.href}
                                    label={item.label}
                                    severity="secondary"
                                    text
                                    aria-current={
                                        path === item.href || path.startsWith(item.href + '/')
                                            ? 'page'
                                            : undefined
                                    }
                                />
                            ))
                        }
                    </nav>

                    <div class="nav-actions">
                        <IconLinkButton href={site.github} label="GitHub" rel="noopener">
                            <Icon name="github" />
                        </IconLinkButton>
                        <IconLinkButton href={site.discord} label="Discord" rel="noopener">
                            <Icon name="discord" />
                        </IconLinkButton>
                        <ThemeToggle />

                        <LinkButton
                            class="nav-cta"
                            href={site.docs}
                            label="Docs"
                            severity="secondary"
                            outlined
                            rel="noopener"
                        >
                            <Icon name="arrow-right" />
                        </LinkButton>
                    </div>
                </div>
            </div>
        </header>

        <main id="main">
            <slot />
        </main>

        <footer class="site-footer">
            <div class="wrap">
                <div class="footer-top">
                    <div class="footer-brand">
                        <span class="brand">
                            <Logo />
                            <span>{site.name}</span>
                        </span>
                        <p>{site.tagline} Every project is MIT licensed and community run.</p>
                        <div class="footer-social">
                            <IconLinkButton href={site.github} label="GitHub" rel="noopener">
                                <Icon name="github" />
                            </IconLinkButton>
                            <IconLinkButton href={site.discord} label="Discord" rel="noopener">
                                <Icon name="discord" />
                            </IconLinkButton>
                            <IconLinkButton href={site.npm} label="npm" rel="noopener">
                                <Icon name="npm" />
                            </IconLinkButton>
                        </div>
                    </div>

                    <div class="footer-col">
                        <h2>Projects</h2>
                        <ul>
                            <li><a href="/projects/openvue">OpenVue</a></li>
                            <li><a href="/projects/openvolt">OpenVolt</a></li>
                            <li><a href="/projects/openux">OpenUXKit</a></li>
                            <li><a href="/projects/openicons">OpenIcons</a></li>
                            <li><a href="/projects#tools-heading">Templates and tools</a></li>
                            <li><a href="/projects">All projects</a></li>
                            <li><a href={site.docs} rel="noopener">openvue.dev</a></li>
                        </ul>
                    </div>

                    <div class="footer-col">
                        <h2>Foundation</h2>
                        <ul>
                            <li><a href="/about">About</a></li>
                            <li><a href="/articles">Articles</a></li>
                            <li><a href="/governance">Governance</a></li>
                            <li><a href="/contribute">Contribute</a></li>
                            <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
                        </ul>
                    </div>
                </div>

                <div class="footer-bottom">
                    <p>&copy; {year} {site.name}. MIT licensed.</p>
                    <p>Not affiliated with PrimeTek Informatics or PrimeUI.</p>
                </div>
            </div>
        </footer>

        <Analytics />

        <script type="application/json" id="stat-sources" set:html={JSON.stringify(statSources)} />
        <script>
            import { fetchStats } from '../data/stats-fetch.js';

            const statEls = document.querySelectorAll<HTMLElement>('[data-stat]');
            const sources = document.getElementById('stat-sources')?.textContent;
            if (statEls.length > 0 && sources) {
                fetchStats(JSON.parse(sources))
                    .then((stats: any) => {
                        const format = new Intl.NumberFormat('en-US');
                        for (const el of statEls) {
                            const key = el.dataset.stat ?? '';
                            const dot = key.indexOf('.');
                            const value =
                                dot === -1
                                    ? stats[key]
                                    : stats[key.slice(0, dot)]?.[key.slice(dot + 1)];
                            if (typeof value === 'number') el.textContent = format.format(value);
                        }
                    })
                    .catch(() => {});
            }
        </script>

        <script>
            const toc = document.querySelector('.doc-toc');
            const links = toc
                ? [...toc.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')]
                : [];
            const targets = links
                .map((link) => document.getElementById(decodeURIComponent(link.hash.slice(1))))
                .filter((el): el is HTMLElement => el !== null);

            if (targets.length > 0) {
                const update = () => {
                    const line = window.innerHeight / 3;
                    let current = targets[0];
                    for (const el of targets) {
                        if (el.getBoundingClientRect().top <= line) current = el;
                    }
                    for (const link of links) {
                        link.classList.toggle('is-current', link.hash === `#${current.id}`);
                    }
                };
                addEventListener('scroll', update, { passive: true });
                update();
            }
        </script>
    </body>
</html>

---
// OpenVue first: global.css owns the shell and overrides component styling
// where the two meet.
import '../styles/openvue.generated.css';
import '../styles/global.css';
import { site, nav } from '../data/site.js';
import Icon from '../components/Icon.astro';
import Logo from '../components/Logo.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import IconLinkButton from '../components/openvue/IconLinkButton.vue';
import LinkButton from '../components/openvue/LinkButton.vue';
import Analytics from '@vercel/analytics/astro';

const {
    title,
    description = site.description,
    /** Extra JSON-LD objects to embed alongside the sitewide Organization graph. */
    schema = [],
    /** Social card image, root-relative. Pages without their own fall back to the sitewide one. */
    image = '/og.png',
    /** Keeps thin or duplicate pages (404) out of the index without hiding them from crawlers. */
    noindex = false
} = Astro.props;

const pageTitle = title ? `${title} | ${site.name}` : `${site.name} | ${site.seoTagline}`;

// `build.format: 'file'` emits about.html, so pathname carries a .html suffix at
// build time. Strip it (and any index) so canonical URLs match the sitemap and
// the extensionless links used throughout the site.
const path =
    Astro.url.pathname
        .replace(/\.html$/, '')
        .replace(/\/index$/, '')
        .replace(/\/$/, '') || '/';
const canonical = new URL(path, site.url).href;
// Crawlers reject relative image paths, so og:image is always absolute.
const ogImage = new URL(image, site.url).href;

const organization = {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': `${site.url}/#organization`,
    name: site.name,
    alternateName: 'OpenVi',
    url: site.url,
    email: site.email,
    description: site.description,
    logo: new URL('/logo.svg', site.url).href,
    sameAs: [site.github, site.npm, site.discord]
};

// Declares the preferred site name for the SERP breadcrumb line.
const website = {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${site.url}/#website`,
    name: site.name,
    alternateName: 'OpenVi',
    url: site.url,
    description: site.description,
    inLanguage: 'en',
    publisher: { '@id': `${site.url}/#organization` }
};

const year = new Date().getFullYear();
---

<html lang="en" data-theme="light">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{pageTitle}</title>
        <meta name="description" content={description} />
        <link rel="canonical" href={canonical} />
        <link rel="sitemap" href="/sitemap-index.xml" />
        {noindex && <meta name="robots" content="noindex, follow" />}

        <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
        <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
        <meta name="theme-color" content="#0b0d10" media="(prefers-color-scheme: dark)" />

        <meta property="og:type" content="website" />
        <meta property="og:site_name" content={site.name} />
        <meta property="og:locale" content="en_US" />
        <meta property="og:title" content={pageTitle} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical} />
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={pageTitle} />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={pageTitle} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImage} />

        {/* Runs before first paint so a stored dark choice never flashes light.
            Nothing is read from the OS: unset means light. */}
        <script is:inline>
            try {
                var stored = localStorage.getItem('theme');
                document.documentElement.dataset.theme = stored === 'dark' ? 'dark' : 'light';
            } catch (e) {
                document.documentElement.dataset.theme = 'light';
            }
        </script>

        <script type="application/ld+json" set:html={JSON.stringify(organization)} />
        <script type="application/ld+json" set:html={JSON.stringify(website)} />
        {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
    </head>

    <body>
        <a class="skip-link" href="#main">Skip to content</a>

        <header class="site-header">
            <div class="wrap">
                <a class="brand" href="/">
                    <Logo />
                    <span class="brand-name">OpenVi Foundation</span>
                </a>

                {/* CSS-only disclosure, so the mobile menu works even if the
                    theme script is the only JavaScript that ever runs. */}
                <input
                    class="nav-toggle-input"
                    type="checkbox"
                    id="nav-toggle"
                    aria-label="Toggle navigation menu"
                />
                <label class="nav-toggle" for="nav-toggle">
                    <span class="nav-toggle-bars" aria-hidden="true"></span>
                    <span class="visually-hidden">Menu</span>
                </label>

                <div class="primary-nav">
                    <nav class="nav-links" aria-label="Primary">
                        {
                            nav.map((item) => (
                                <LinkButton
                                    href={item.href}
                                    label={item.label}
                                    severity="secondary"
                                    text
                                    aria-current={
                                        path === item.href || path.startsWith(item.href + '/')
                                            ? 'page'
                                            : undefined
                                    }
                                />
                            ))
                        }
                        <LinkButton href={site.docs} label="Docs" severity="secondary" text rel="noopener" />
                    </nav>

                    <div class="nav-actions">
                        <IconLinkButton href={site.github} label="GitHub" rel="noopener">
                            <Icon name="github" />
                        </IconLinkButton>
                        <IconLinkButton href={site.discord} label="Discord" rel="noopener">
                            <Icon name="discord" />
                        </IconLinkButton>
                        <ThemeToggle />
                    </div>
                </div>
            </div>
        </header>

        <main id="main">
            <div class="wrap">
                <slot />
            </div>
        </main>

        <footer class="site-footer">
            <div class="wrap">
                <div class="footer-top">
                    <div class="footer-brand">
                        <span class="brand">
                            <Logo />
                            <span>{site.name}</span>
                        </span>
                        <p>{site.tagline} Every project is MIT licensed and community run.</p>
                        <div class="footer-social">
                            <IconLinkButton href={site.github} label="GitHub" rel="noopener">
                                <Icon name="github" />
                            </IconLinkButton>
                            <IconLinkButton href={site.discord} label="Discord" rel="noopener">
                                <Icon name="discord" />
                            </IconLinkButton>
                            <IconLinkButton href={site.npm} label="npm" rel="noopener">
                                <Icon name="npm" />
                            </IconLinkButton>
                        </div>
                    </div>

                    <div class="footer-col">
                        <h2>Projects</h2>
                        <ul>
                            <li><a href="/projects/openvue">OpenVue</a></li>
                            <li><a href="/projects/openux">OpenUXKit</a></li>
                            <li><a href="/projects/openicons">OpenIcons</a></li>
                            <li><a href="/projects">All projects</a></li>
                            <li><a href={site.docs} rel="noopener">openvue.dev</a></li>
                        </ul>
                    </div>

                    <div class="footer-col">
                        <h2>Foundation</h2>
                        <ul>
                            <li><a href="/about">About</a></li>
                            <li><a href="/governance">Governance</a></li>
                            <li><a href="/contribute">Contribute</a></li>
                            <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
                        </ul>
                    </div>
                </div>

                <div class="footer-bottom">
                    <p>&copy; {year} {site.name}. MIT licensed.</p>
                    <p>Not affiliated with PrimeTek Informatics or PrimeUI.</p>
                </div>
            </div>
        </footer>

        <Analytics />
    </body>
</html>

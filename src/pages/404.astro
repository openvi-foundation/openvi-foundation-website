---
import Base from '../layouts/Base.astro';
import LinkButton from '../components/openvue/LinkButton.vue';
import Notice from '../components/openvue/Notice.vue';
import { projects } from '../data/projects.js';
---

<Base title="Page not found" description="That page does not exist." noindex>
    <div class="prose">
        <h1>Page not found</h1>
        <Notice severity="warn">That page does not exist.</Notice>
        <div class="button-row">
            <LinkButton href="/" label="Home" />
            <LinkButton href="/projects" label="All projects" severity="secondary" outlined />
            {
                projects.map((p) => (
                    <LinkButton
                        href={`/projects/${p.slug}`}
                        label={p.name}
                        severity="secondary"
                        text
                    />
                ))
            }
        </div>
    </div>
</Base>

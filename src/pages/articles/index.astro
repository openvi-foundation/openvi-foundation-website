---
import Base from '../../layouts/Base.astro';
import ArticleList from '../../components/ArticleList.astro';
import Icon from '../../components/Icon.astro';
import { articlesByDate, coverOf, formatDate, kindLabels, readingTime } from '../../data/articles.js';
import { site } from '../../data/site.js';

const description =
    'Everything the OpenVi Foundation has published about the PrimeVue fork: release notes, migration guidance, and the posts that opened the discussion.';

const [latest, ...earlier] = articlesByDate;
const cover = coverOf(latest);

const schema = [
    {
        '@context': 'https://schema.org',
        '@type': 'Blog',
        '@id': `${site.url}/articles#blog`,
        name: 'OpenVi Foundation articles',
        description,
        url: `${site.url}/articles`,
        inLanguage: 'en',
        publisher: { '@id': `${site.url}/#organization` },
        isPartOf: { '@id': `${site.url}/#website` },
        blogPost: articlesByDate.map((a) => ({
            '@type': a.kind === 'article' ? 'BlogPosting' : 'DiscussionForumPosting',
            headline: a.title,
            description: a.metaDescription,
            datePublished: a.date,
            url: `${site.url}/articles/${a.slug}`,
            author: { '@type': 'Person', name: a.author }
        }))
    }
];
---

<Base
    title="Articles"
    description={description}
    schema={schema}
    image="/og/articles.png"
    pageType="CollectionPage"
    breadcrumbs={[{ name: 'Articles', path: '/articles' }]}
>
    <section class="band hero hero-doc">
        <div class="wrap">
            <h1>Articles</h1>
            <p class="lede">
                Release notes, migration guidance, and the posts that opened the discussion.
            </p>
        </div>
    </section>

    <section class="band">
        <div class="wrap">
            <article class:list={['featured', !cover && 'featured-solo']}>
                <div class="featured-text">
                    <p class="article-card-meta">
                        <span>{kindLabels[latest.kind].label}</span>
                        <span aria-hidden="true">·</span>
                        <time datetime={latest.date}>{formatDate(latest.date)}</time>
                        <span aria-hidden="true">·</span>
                        <span>{readingTime(latest)} min read</span>
                    </p>
                    <h2 class="featured-title">
                        <a href={`/articles/${latest.slug}`}>{latest.title}</a>
                    </h2>
                    <p class="featured-lede">{latest.lede ?? latest.summary}</p>
                    <span class="card-more" aria-hidden="true">
                        Read the article <Icon name="arrow-right" />
                    </span>
                </div>
                {
                    cover && (
                        <figure class="featured-media">
                            <img
                                src={cover.src}
                                alt={cover.alt}
                                width={cover.width}
                                height={cover.height}
                                fetchpriority="high"
                                decoding="async"
                            />
                        </figure>
                    )
                }
            </article>

            <div class="section-head">
                <h2>Earlier</h2>
            </div>
            <ArticleList items={earlier} heading="h3" />
        </div>
    </section>
</Base>

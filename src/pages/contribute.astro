---
import Base from '../layouts/Base.astro';
import DocPage from '../components/DocPage.astro';
import InlineCode from '../components/InlineCode.astro';
import { projects, tools } from '../data/projects.js';
import { site } from '../data/site.js';

const description =
    'Help maintain the OpenVi Foundation projects: fix issues, report bugs, write docs, or join the maintainer team. Where each project needs help, and how to start.';

const contents = [
    { id: 'ways-to-help', text: 'Ways to help' },
    { id: 'projects', text: 'Where each project needs help' },
    { id: 'before-you-open-a-pull-request', text: 'Before you open a pull request' },
    { id: 'becoming-a-maintainer', text: 'Becoming a maintainer' },
    { id: 'conduct-and-security', text: 'Conduct and security' }
];
---

<Base title="Contribute" description={description}
    image="/og/contribute.png"
    pageType="WebPage"
    breadcrumbs={[{ name: 'Contribute', path: '/contribute' }]}
>
    <DocPage
        title="Contribute"
        lede="We are building out the maintainer team now. If you know these libraries well, or want to, you are the person we are looking for."
        label="Contribute"
        contents={contents}
    >
        <h2 id="ways-to-help">Ways to help</h2>
        <p>
            Every project works the same way: issues and pull requests on GitHub, conversation on <a
                href={site.discord}
                rel="noopener">Discord</a
            >. None of it needs prior involvement.
        </p>
        <ul>
            <li>
                <strong>Fix something.</strong> Pick up an open issue, say you are on it, and open a
                pull request.
            </li>
            <li>
                <strong>Report a bug well.</strong> A minimal reproduction is worth more than a long
                description. For OpenVue there is a <a
                    href="https://stackblitz.com/github/openvi-foundation/openvue-reproducer?file=src%2FApp.vue"
                    rel="noopener">one-click StackBlitz starter</a
                > for exactly that.
            </li>
            <li>
                <strong>Improve the documentation.</strong> Gaps and inaccuracies are bugs too.
            </li>
            <li>
                <strong>Test accessibility.</strong> Real assistive-technology testing, reported
                against specific screen readers and versions.
            </li>
            <li>
                <strong>Review.</strong> Reading and testing other people's pull requests is how most
                maintainers start.
            </li>
        </ul>

        <h2 id="projects">Where each project needs help</h2>
        {
            projects.map((project) => (
                <>
                    <h3>
                        <a href={`/projects/${project.slug}`}>{project.name}</a>
                    </h3>
                    <ul>
                        {project.contribute.help.map((item) => (
                            <li>
                                <InlineCode text={item} />
                            </li>
                        ))}
                    </ul>
                    <pre><code>{project.contribute.setup}</code></pre>
                    <p class="small">
                        <a href={`https://github.com/${project.githubRepo}/issues`} rel="noopener">
                            Open issues
                        </a>
                        {project.contribute.guide && (
                            <>
                                {' · '}
                                <a href={project.contribute.guide} rel="noopener">
                                    Contributing guide
                                </a>
                            </>
                        )}
                    </p>
                </>
            ))
        }
        <p>
            The templates and starters ({tools.map((t) => t.name).join(', ')}) take pull requests the
            same way. They are listed under <a href="/projects#tools-heading">templates and tools</a>.
        </p>

        <h2 id="before-you-open-a-pull-request">Before you open a pull request</h2>
        <ul>
            <li>
                Open an issue first for anything bigger than a bug fix, so the approach can be agreed
                on.
            </li>
            <li>
                Keep the public API compatible with the release line it belongs to. A breaking change
                needs a documented migration path and waits for the next major version.
            </li>
            <li>Include a test where the change is testable, and run the existing suites.</li>
            <li>One logical change per pull request. Reviewable diffs get merged faster.</li>
        </ul>

        <h2 id="becoming-a-maintainer">Becoming a maintainer</h2>
        <p>
            Commit access follows sustained, review-quality contribution rather than affiliation, on
            any of the projects. Start by picking up issues, then reach out on <a
                href={site.discord}
                rel="noopener">Discord</a
            > or at <a href={`mailto:${site.email}`}>{site.email}</a>. See <a href="/governance"
                >governance</a
            > for how decisions get made.
        </p>

        <h2 id="conduct-and-security">Conduct and security</h2>
        <p>
            Participation in every repository and on Discord is covered by the code of conduct
            described in <a href="/governance#code-of-conduct">governance</a>. Security issues are
            never reported as public issues: follow the <a
                href="https://github.com/openvi-foundation/openvue/blob/master/SECURITY.md"
                rel="noopener">security policy</a
            > instead.
        </p>
    </DocPage>
</Base>

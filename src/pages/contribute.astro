---
import Base from '../layouts/Base.astro';
import DocPage from '../components/DocPage.astro';
import { site } from '../data/site.js';

const description =
    'Help maintain OpenVue: triage the issue backlog, report migration gaps, or join the maintainer team. Start in Discord, no prior involvement needed.';

/** Section headings, mirrored into the margin column by DocPage. */
const contents = [
    { id: 'where-help-is-most-needed', text: 'Where help is most needed' },
    { id: 'development-setup', text: 'Development setup' },
    { id: 'before-you-open-a-pull-request', text: 'Before you open a pull request' },
    { id: 'becoming-a-maintainer', text: 'Becoming a maintainer' },
    { id: 'reporting-a-security-issue', text: 'Reporting a security issue' }
];
---

<Base title="Contribute to OpenVue" description={description}
    image="/og/contribute.png"
    pageType="WebPage"
    breadcrumbs={[{ name: 'Contribute', path: '/contribute' }]}
>
    <DocPage
        title="Contribute"
        lede="We are building out the maintainer team now. If you know Vue and these libraries well, you are the person we are looking for."
        label="Contribute"
        contents={contents}
    >
        <h2 id="where-help-is-most-needed">Where help is most needed</h2>
        <ul>
            <li>
                <strong>Issue backlog.</strong> Reproducing, triaging and fixing inherited issues is
                the highest-value work right now.
            </li>
            <li>
                <strong>Migration reports.</strong> If <code>npx @openvue/migrate</code> misses something
                in your codebase, file it. That makes the path easier for everyone behind you.
            </li>
            <li>
                <strong>Accessibility.</strong> Real assistive-technology testing on components,
                reported against specific screen readers and versions.
            </li>
            <li>
                <strong>Documentation.</strong> Gaps and inaccuracies on <a
                    href="https://openvue.dev"
                    rel="noopener">openvue.dev</a
                >, especially around theming and unstyled mode.
            </li>
        </ul>

        <h2 id="development-setup">Development setup</h2>
        <p>The monorepo uses pnpm workspaces.</p>
        <pre><code>git clone https://github.com/openvi-foundation/openvue.git
cd openvue
pnpm install
pnpm run dev</code></pre>
        <p>
            The full setup, project layout and review process are in the <a
                href="https://github.com/openvi-foundation/openvue/blob/main/CONTRIBUTING.md"
                rel="noopener">contributing guide</a
            >.
        </p>

        <h2 id="before-you-open-a-pull-request">Before you open a pull request</h2>
        <ul>
            <li>
                Open an issue first for anything bigger than a bug fix, so the approach can be agreed
                on.
            </li>
            <li>
                Keep the component API compatible with PrimeVue 4.x unless there is a documented
                migration path.
            </li>
            <li>Include a test where the change is testable, and run the existing suites.</li>
            <li>One logical change per pull request. Reviewable diffs get merged faster.</li>
        </ul>

        <h2 id="becoming-a-maintainer">Becoming a maintainer</h2>
        <p>
            Commit access follows sustained, review-quality contribution rather than affiliation.
            Start by picking up issues, then reach out on <a href={site.discord} rel="noopener"
                >Discord</a
            > or at <a href={`mailto:${site.email}`}>{site.email}</a>. See <a href="/governance"
                >governance</a
            > for how decisions get made.
        </p>

        <h2 id="reporting-a-security-issue">Reporting a security issue</h2>
        <p>
            Do not open a public issue. Follow the <a
                href="https://github.com/openvi-foundation/openvue/blob/main/SECURITY.md"
                rel="noopener">security policy</a
            >.
        </p>
    </DocPage>
</Base>

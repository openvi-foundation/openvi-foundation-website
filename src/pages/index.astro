---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import PixelBlast from '../components/vendor/PixelBlast.vue';
import LinkButton from '../components/openvue/LinkButton.vue';
import StatusTag from '../components/openvue/StatusTag.vue';
import { projects, statusLabels } from '../data/projects.js';
import { faq } from '../data/faq.js';
import { site } from '../data/site.js';
import { getStats, formatCount } from '../data/stats.js';

const description =
    'The OpenVi Foundation maintains open source UI libraries for the web: OpenVue, OpenVolt, OpenIcons and OpenUXKit. Community run and permanently MIT licensed.';

const schema = [
    // The questions are on the page and in the markup. Google matches one
    // against the other, so the two must not drift apart.
    {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        '@id': `${site.url}/#faq`,
        mainEntity: faq.map((item) => ({
            '@type': 'Question',
            name: item.q,
            acceptedAnswer: { '@type': 'Answer', text: item.a }
        }))
    },
    {
        '@context': 'https://schema.org',
        '@type': 'ItemList',
        name: 'OpenVi Foundation projects',
        itemListElement: projects.map((p, i) => ({
            '@type': 'ListItem',
            position: i + 1,
            name: p.name,
            description: p.metaDescription,
            url: `${site.url}/projects/${p.slug}`
        }))
    }
];

// Proof the projects are alive, fetched at build time and counted across the
// whole foundation rather than any one project. Any figure that could not be
// fetched is dropped rather than shown as a stale or invented number.
const stats = await getStats();

const figures = [
    { value: String(projects.length), label: 'maintained libraries', href: '/projects' },
    stats.totalStars != null && {
        value: formatCount(stats.totalStars),
        label: 'GitHub stars',
        href: site.github
    },
    stats.totalDownloads != null && {
        value: formatCount(stats.totalDownloads),
        label: 'npm downloads last week',
        href: site.npm
    },
    stats.contributors != null && {
        value: formatCount(stats.contributors),
        label: 'contributors since the forks',
        href: '/contribute'
    }
].filter(Boolean);

const migrateCommand = 'npx @openvue/migrate';

// The reasons the foundation exists, set side by side as three short points.
const openvue = projects.find((p) => p.slug === 'openvue');

const rationale = [
    {
        kind: 'versions',
        title: 'We started with PrimeVue',
        body: 'The MIT 4.x line last shipped in April 2026 and now gets security fixes only, while new development moved off MIT. It is still pulled from npm over 400,000 times a week.'
    },
    {
        kind: 'stack',
        title: 'The whole stack, in one place',
        body: 'Components, theming engine and icon set are all maintained here, so nothing critical resolves at runtime from a scope we do not control.'
    },
    {
        kind: 'license',
        title: 'MIT, permanently',
        body: 'Every project here is MIT and stays MIT. A relicense upstream cannot reach these packages.'
    }
];

// What each reason points at, shown above it: the release lines, the packages
// that make up the stack, and the head of the license itself.
const versionLines = [
    { pkg: 'primevue', version: '4.5.5', note: 'MIT, security fixes only', tone: 'archived' },
    { pkg: 'primevue', version: '5.x', note: 'PrimeUI License', tone: 'muted' },
    { pkg: 'openvue', version: openvue.version, note: 'MIT, maintained', tone: 'live' }
];

const stackPackages = [
    { pkg: 'openvue', role: 'Components' },
    { pkg: '@openvue/themes', role: 'Theme presets' },
    { pkg: '@openuxkit/themes', role: 'Theming engine' },
    { pkg: '@openvue/openicons', role: 'Icons' },
    { pkg: 'openvolt-vue', role: 'Tailwind components' }
];

// The opening of the OpenVue LICENSE.md, as published: both copyright lines,
// because the upstream one is the point.
const licenseHead = [
    'The MIT License (MIT)',
    '',
    'Copyright (c) 2018-2025 PrimeTek',
    'Copyright (c) 2026 OpenVue Foundation and contributors',
    '',
    'Permission is hereby granted, free of charge,',
    'to any person obtaining a copy of this software',
    'and associated documentation files (the',
    '"Software"), to deal in the Software without',
    'restriction, including without limitation...'
];
---

<Base title={null} description={description} schema={schema}>
    <section class="band hero hero-home">
        {/* Decoration and nothing else: it carries no text, it is hydrated
            late, and the masthead reads the same without it. */}
        <div class="hero-field" aria-hidden="true">
            <PixelBlast
                client:idle
                variant="square"
                color="#45c48c"
                pixelSize={4}
                patternScale={2.6}
                patternDensity={1.1}
                pixelSizeJitter={0.4}
                edgeFade={0.6}
                speed={0.35}
                enableRipples={false}
                transparent
            />
        </div>

        <div class="wrap">
            <div class="hero-grid">
                <div class="hero-copy">
                    <h1>Maintained, <span class="hero-accent">not archived</span></h1>
                    <p class="lede">
                        We build and maintain open source UI libraries for the web. Components,
                        theming, icons and the tooling around them, all MIT licensed and community
                        run.
                    </p>
                    <div class="hero-actions">
                        <LinkButton href="/projects" label="Browse projects">
                            <Icon name="arrow-right" class="icon-trail" />
                        </LinkButton>
                        <LinkButton
                            href={site.docs}
                            label="Read the docs"
                            severity="secondary"
                            outlined
                            rel="noopener"
                        />
                        <LinkButton
                            href={site.github}
                            label="GitHub"
                            severity="secondary"
                            text
                            rel="noopener"
                        >
                            <Icon name="github" />
                        </LinkButton>
                    </div>
                </div>

                {/* The thesis as a figure: where each upstream stands now, and
                    what carries it on. Every row is a link to the continuation. */}
                <section class="board" aria-labelledby="board-heading">
                    <h2 id="board-heading" class="board-title">What we picked up</h2>
                    <ul class="board-list">
                        {
                            projects.map((p) => (
                                <li>
                                    <a href={`/projects/${p.slug}`}>
                                        <span class="board-side">
                                            <span class="board-name board-from">{p.continues}</span>
                                            <span class="board-meta board-meta-upstream">
                                                {p.upstreamStatus}
                                            </span>
                                        </span>
                                        <span class="board-arrow" aria-hidden="true">
                                            <Icon name="arrow-right" />
                                        </span>
                                        <span class="board-side">
                                            <span class="board-name board-to">{p.name}</span>
                                            <span class="board-meta">v{p.version} · MIT</span>
                                        </span>
                                    </a>
                                </li>
                            ))
                        }
                    </ul>
                    <div class="board-foot">
                        <span class="board-foot-label">Moving a PrimeVue 4 project?</span>
                        <div class="cmd" data-copy={migrateCommand}>
                            <code><span class="cmd-prompt" aria-hidden="true">$</span>{migrateCommand}</code>
                            <button type="button" class="cmd-copy" aria-label="Copy command">
                                <Icon name="copy" class="cmd-icon-copy" />
                                <Icon name="check" class="cmd-icon-done" />
                            </button>
                        </div>
                        <a class="board-foot-link" href="/projects/openvue/migrate">
                            Read the migration guide <Icon name="arrow-right" />
                        </a>
                    </div>
                </section>
            </div>

            {
                figures.length > 0 && (
                    <ul class="hero-stats" aria-label="The projects in numbers">
                        {figures.map((f) => (
                            <li>
                                <a
                                    href={f.href}
                                    rel={f.href.startsWith('http') ? 'noopener' : undefined}
                                >
                                    <span class="hero-stats-value">{f.value}</span>
                                    <span class="hero-stats-label">{f.label}</span>
                                </a>
                            </li>
                        ))}
                    </ul>
                )
            }
        </div>
    </section>

    <section class="band home-band" aria-labelledby="projects-heading">
        <div class="wrap">
            <h2 id="projects-heading" class="home-head">The full stack a UI library needs</h2>

            {/* Built here rather than with ProjectList: the home page shows the
                projects as a grid to pick from, /projects as a register to read. */}
            <ul class="project-grid">
                {
                    projects.map((p) => {
                        const status = statusLabels[p.status];
                        return (
                            <li class="project-tile">
                                <div class="project-tile-top">
                                    <h3 class="project-tile-name">
                                        <a href={`/projects/${p.slug}`}>{p.name}</a>
                                    </h3>
                                    <StatusTag
                                        version={p.version}
                                        status={p.status}
                                        label={status.label}
                                        note={status.note}
                                    />
                                </div>
                                <p class="project-tile-continues">
                                    continues {p.continues}
                                </p>
                                <p class="project-tile-tagline">{p.tagline}</p>
                                <div class="cmd project-tile-install" data-copy={p.install}>
                                    <code><span class="cmd-prompt" aria-hidden="true">$</span>{p.install}</code>
                                    <button
                                        type="button"
                                        class="cmd-copy"
                                        aria-label={`Copy install command for ${p.name}`}
                                    >
                                        <Icon name="copy" class="cmd-icon-copy" />
                                        <Icon name="check" class="cmd-icon-done" />
                                    </button>
                                </div>
                                <div class="project-tile-foot">
                                    <span class="project-tile-facts">
                                        {p.language} · {p.license}
                                    </span>
                                    <span class="project-tile-more" aria-hidden="true">
                                        Details <Icon name="arrow-right" />
                                    </span>
                                </div>
                            </li>
                        );
                    })
                }
            </ul>
        </div>
    </section>

    <section class="band home-band home-band-subtle" aria-labelledby="why-heading">
        <div class="wrap">
            <h2 id="why-heading" class="home-head">Why the foundation exists</h2>

            <ul class="reasons">
                {
                    rationale.map((item) => (
                        <li class="reason">
                            <div class="reason-figure" aria-hidden="true">
                                {item.kind === 'versions' && (
                                    <ul class="figure-rows">
                                        {versionLines.map((line) => (
                                            <li>
                                                <code>
                                                    {line.pkg}
                                                    <span class="figure-faint">@{line.version}</span>
                                                </code>
                                                <span class={`figure-note tone-${line.tone}`}>
                                                    {line.note}
                                                </span>
                                            </li>
                                        ))}
                                    </ul>
                                )}
                                {item.kind === 'stack' && (
                                    <ul class="figure-rows">
                                        {stackPackages.map((row) => (
                                            <li>
                                                <code>{row.pkg}</code>
                                                <span class="figure-note">{row.role}</span>
                                            </li>
                                        ))}
                                    </ul>
                                )}
                                {item.kind === 'license' && (
                                    <pre class="figure-license">{licenseHead.join('\n')}</pre>
                                )}
                            </div>
                            <div class="reason-text">
                                <h3>{item.title}</h3>
                                <p>{item.body}</p>
                            </div>
                        </li>
                    ))
                }
            </ul>
        </div>
    </section>

    <section class="band home-band" aria-labelledby="faq-heading">
        <div class="wrap faq-layout">
            <div class="faq-aside">
                <h2 id="faq-heading">Common questions</h2>
                <p class="faq-aside-more">
                    Something else? Ask on <a href={site.discord} rel="noopener">Discord</a> or
                    write to <a href={`mailto:${site.email}`}>{site.email}</a>.
                </p>
            </div>

            {/* Plain headings and paragraphs rather than a disclosure widget:
                the answers are the reason the page ranks for these questions,
                so they are on the page rather than hidden behind a control. */}
            <dl class="faq">
                {
                    faq.map((item) => (
                        <div>
                            <dt>{item.q}</dt>
                            <dd>{item.a}</dd>
                        </div>
                    ))
                }
            </dl>
        </div>
    </section>

    <section class="band home-cta" aria-labelledby="cta-heading">
        <div class="wrap">
            <div class="home-cta-inner">
                <div>
                    <h2 id="cta-heading">Help keep it maintained</h2>
                    <p>
                        Triage an issue, test a release against your app, or fix a doc. Commit
                        access follows sustained contribution, not affiliation.
                    </p>
                </div>
                <div class="hero-actions">
                    <LinkButton href="/contribute" label="Start contributing">
                        <Icon name="arrow-right" class="icon-trail" />
                    </LinkButton>
                    <LinkButton
                        href={site.discord}
                        label="Join Discord"
                        severity="secondary"
                        outlined
                        rel="noopener"
                    >
                        <Icon name="discord" />
                    </LinkButton>
                </div>
            </div>
            <p class="home-cta-note">
                OpenVi Foundation is not affiliated with, sponsored by, or endorsed by PrimeTek
                Informatics or PrimeUI.
            </p>
        </div>
    </section>

    <script>
        // Copy-to-clipboard for the shell commands on the page. Without JavaScript the
        // button does nothing and the command is still there to select.
        for (const box of document.querySelectorAll<HTMLElement>('.cmd[data-copy]')) {
            const button = box.querySelector('button');
            button?.addEventListener('click', async () => {
                try {
                    await navigator.clipboard.writeText(box.dataset.copy ?? '');
                    box.classList.add('is-copied');
                    setTimeout(() => box.classList.remove('is-copied'), 1600);
                } catch {
                    // Clipboard blocked: leave the command for manual selection.
                }
            });
        }
    </script>
</Base>

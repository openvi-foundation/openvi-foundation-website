---
import Base from '../layouts/Base.astro';
import ProjectList from '../components/ProjectList.astro';
import Icon from '../components/Icon.astro';
import LinkButton from '../components/openvue/LinkButton.vue';
import FeatureCard from '../components/openvue/FeatureCard.vue';
import Callout from '../components/openvue/Callout.vue';
import { projects } from '../data/projects.js';
import { site } from '../data/site.js';

const description =
    'OpenVue continues PrimeVue after its archive: 80+ accessible Vue and Nuxt components, a theming engine and an icon set. Community run and MIT licensed.';

const schema = [
    {
        '@context': 'https://schema.org',
        '@type': 'ItemList',
        name: 'OpenVi Foundation projects',
        itemListElement: projects.map((p, i) => ({
            '@type': 'ListItem',
            position: i + 1,
            name: p.name,
            description: p.metaDescription,
            url: `${site.url}/projects/${p.slug}`
        }))
    }
];
---

<Base title={null} description={description} schema={schema}>
    <section class="hero prose">
        <h1>UI libraries that outlive their maintainers</h1>
        <p class="lede">
            We build and maintain open source UI libraries for the web. Components, theming, icons
            and the tooling around them, all MIT licensed and community run.
        </p>
        <div class="hero-actions">
            <LinkButton href="/projects" label="Browse projects">
                <Icon name="arrow-right" />
            </LinkButton>
            <LinkButton href={site.docs} label="Read the docs" severity="secondary" outlined rel="noopener" />
            <LinkButton href={site.github} label="GitHub" severity="secondary" outlined rel="noopener">
                <Icon name="github" />
            </LinkButton>
        </div>
    </section>

    <section aria-labelledby="projects-heading">
        <div class="section-head">
            <h2 id="projects-heading">Projects</h2>
            <p class="muted">
                Three repositories covering the full stack a UI library needs. Each one is versioned
                and published independently.
            </p>
        </div>
        <ProjectList items={projects} heading="h3" />
    </section>

    <section aria-labelledby="why-heading">
        <div class="section-head">
            <h2 id="why-heading">Why the foundation exists</h2>
            <p class="muted">
                To keep widely used libraries maintained after their original maintainers move on.
            </p>
        </div>
        <ul class="feature-grid">
            <li>
                <FeatureCard title="We started with PrimeVue">
                    Its last release, 4.5.5, shipped in April 2026 and the repository is archived.
                    The package is still pulled from npm over half a million times a week.
                </FeatureCard>
            </li>
            <li>
                <FeatureCard title="The whole stack, in one place">
                    Components, theming engine and icon set are all maintained here, so nothing
                    critical resolves at runtime from a scope we do not control.
                </FeatureCard>
            </li>
            <li>
                <FeatureCard title="MIT, permanently">
                    Every project here is MIT and stays MIT. A relicense upstream cannot reach these
                    packages.
                </FeatureCard>
            </li>
        </ul>
    </section>

    <Callout header="Migrating from PrimeVue" headingId="start-heading" aria-labelledby="start-heading">
        <p class="muted">
            If you have a PrimeVue v4 project, one command moves it across. It prints a plan first
            and asks before writing anything.
        </p>
        <pre><code>npx @openvue/migrate</code></pre>
        <p class="muted">
            It renames dependencies, rewrites imports, adds a compatibility override so third-party
            libraries keep resolving, and leaves a single reviewable diff. Run it with <code
                >--dry</code
            > for a preview that writes nothing. The full guide is at <a
                href="https://openvue.dev/migrate"
                rel="noopener">openvue.dev/migrate</a
            >.
        </p>
    </Callout>

    <p class="small muted">
        OpenVi Foundation is not affiliated with, sponsored by, or endorsed by PrimeTek Informatics
        or PrimeUI.
    </p>
</Base>

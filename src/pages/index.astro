---
import Base from '../layouts/Base.astro';
import ProjectList from '../components/ProjectList.astro';
import Icon from '../components/Icon.astro';
import PixelBlast from '../components/vendor/PixelBlast.vue';
import LinkButton from '../components/openvue/LinkButton.vue';
import FeatureCard from '../components/openvue/FeatureCard.vue';
import { projects } from '../data/projects.js';
import { faq } from '../data/faq.js';
import { site } from '../data/site.js';
import { getStats, formatCount } from '../data/stats.js';

const description =
    'The OpenVi Foundation maintains open source UI libraries for the web: OpenVue, OpenVolt, OpenIcons and OpenUXKit. Community run and permanently MIT licensed.';

const schema = [
    // The questions are on the page and in the markup. Google matches one
    // against the other, so the two must not drift apart.
    {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        '@id': `${site.url}/#faq`,
        mainEntity: faq.map((item) => ({
            '@type': 'Question',
            name: item.q,
            acceptedAnswer: { '@type': 'Answer', text: item.a }
        }))
    },
    {
        '@context': 'https://schema.org',
        '@type': 'ItemList',
        name: 'OpenVi Foundation projects',
        itemListElement: projects.map((p, i) => ({
            '@type': 'ListItem',
            position: i + 1,
            name: p.name,
            description: p.metaDescription,
            url: `${site.url}/projects/${p.slug}`
        }))
    }
];

// Proof the projects are alive, fetched at build time and counted across the
// whole foundation rather than any one project. Any figure that could not be
// fetched is dropped rather than shown as a stale or invented number.
const stats = await getStats();

const figures = [
    { value: String(projects.length), label: 'maintained libraries', href: '/projects' },
    stats.totalStars != null && {
        value: formatCount(stats.totalStars),
        label: 'GitHub stars across the foundation',
        href: site.github
    },
    stats.totalDownloads != null && {
        value: formatCount(stats.totalDownloads),
        label: 'npm downloads last week',
        href: site.npm
    },
    stats.contributors != null && {
        value: formatCount(stats.contributors),
        label: 'contributors since the forks',
        href: '/contribute'
    }
].filter(Boolean);

// The reasons the foundation exists, as numbered clauses rather than a card
// grid: they are an argument in sequence, not three parallel features.
const rationale = [
    {
        title: 'We started with PrimeVue',
        body: 'Its last release, 4.5.5, shipped in April 2026 and the repository is archived. The package is still pulled from npm over half a million times a week.'
    },
    {
        title: 'The whole stack, in one place',
        body: 'Components, theming engine and icon set are all maintained here, so nothing critical resolves at runtime from a scope we do not control.'
    },
    {
        title: 'MIT, permanently',
        body: 'Every project here is MIT and stays MIT. A relicense upstream cannot reach these packages.'
    }
];
---

<Base title={null} description={description} schema={schema}>
    <section class="band hero">
        {/* Decoration and nothing else: it carries no text, it is hydrated
            late, and the masthead reads the same without it. */}
        <div class="hero-field" aria-hidden="true">
            <PixelBlast
                client:idle
                variant="square"
                color="#45c48c"
                pixelSize={4}
                patternScale={2.6}
                patternDensity={1.1}
                pixelSizeJitter={0.4}
                edgeFade={0.6}
                speed={0.35}
                enableRipples={false}
                transparent
            />
        </div>

        <div class="wrap">
            <h1>Maintained, not archived</h1>
            <div class="hero-rule"></div>
            <p class="lede">
                We build and maintain open source UI libraries for the web. Components, theming,
                icons and the tooling around them, all MIT licensed and community run.
            </p>
            <div class="hero-actions">
                <LinkButton href="/projects" label="Browse projects">
                    <Icon name="arrow-right" />
                </LinkButton>
                <LinkButton
                    href={site.docs}
                    label="Read the docs"
                    severity="secondary"
                    outlined
                    rel="noopener"
                />
                <LinkButton href={site.github} label="GitHub" severity="secondary" text rel="noopener">
                    <Icon name="github" />
                </LinkButton>
            </div>
        </div>
    </section>

    {
        figures.length > 0 && (
            <section class="band band-tight" aria-label="The projects in numbers">
                <div class="wrap">
                    <ul class="stats">
                        {figures.map((f) => (
                            <li>
                                <a href={f.href} rel={f.href.startsWith('http') ? 'noopener' : undefined}>
                                    <span class="stats-value">{f.value}</span>
                                    <span class="stats-label">{f.label}</span>
                                </a>
                            </li>
                        ))}
                    </ul>
                </div>
            </section>
        )
    }

    <section class="band" aria-labelledby="succession-heading">
        <div class="wrap">
            <div>
                <div class="section-head">
                    <h2 id="succession-heading">What we picked up</h2>
                    <p>
                        Four upstream projects that stopped moving, each with a maintained
                        continuation published under a license that cannot be changed out from
                        under it.
                    </p>
                </div>

                <ul class="succession">
                    {
                        projects.map((p) => (
                            <li>
                                <span class="from">{p.continues}</span>
                                <span class="arrow" aria-hidden="true">
                                    &rarr;
                                </span>
                                <span class="to">
                                    <a href={`/projects/${p.slug}`}>{p.name}</a>
                                    <span class="version">v{p.version}</span>
                                </span>
                            </li>
                        ))
                    }
                </ul>
                {/* The one pointer to a project guide on this page. The guide
                    itself belongs to OpenVue, so the home page only says
                    where it is. */}
                <p class="small muted succession-note">
                    Moving an existing PrimeVue 4 project? <a href="/projects/openvue/migrate"
                        >OpenVue's migration guide</a
                    > does it in one command.
                </p>
            </div>
        </div>
    </section>

    <section class="band" aria-labelledby="projects-heading">
        <div class="wrap">
            <div>
                <div class="section-head">
                    <h2 id="projects-heading">Projects</h2>
                    <p>
                        Components, Tailwind components you own, a theming engine and an icon set:
                        the full stack a UI library needs, each one published to npm on its own.
                    </p>
                </div>
                <ProjectList items={projects} heading="h3" />
            </div>
        </div>
    </section>

    <section class="band" aria-labelledby="why-heading">
        <div class="wrap">
            <div>
                <div class="section-head">
                    <h2 id="why-heading">Why the foundation exists</h2>
                    <p>
                        To keep widely used libraries maintained after their original maintainers
                        move on.
                    </p>
                </div>
                <ul class="notes">
                    {
                        rationale.map((item) => (
                            <li>
                                <FeatureCard title={item.title}>
                                    {item.body}
                                </FeatureCard>
                            </li>
                        ))
                    }
                </ul>
            </div>
        </div>
    </section>

    <section class="band" aria-labelledby="faq-heading">
        <div class="wrap">
            <div class="section-head">
                <h2 id="faq-heading">Common questions</h2>
                <p>
                    What people ask most often about the foundation, its projects and how they
                    are run.
                </p>
            </div>

            {/* Plain headings and paragraphs rather than a disclosure widget:
                the answers are the reason the page ranks for these questions,
                so they are on the page rather than hidden behind a control. */}
            <dl class="faq">
                {
                    faq.map((item) => (
                        <div>
                            <dt>{item.q}</dt>
                            <dd>{item.a}</dd>
                        </div>
                    ))
                }
            </dl>
        </div>
    </section>

    <section class="band band-tight">
        <div class="wrap">
            <p class="small muted" style="margin: 0; max-width: var(--measure);">
                OpenVi Foundation is not affiliated with, sponsored by, or endorsed by PrimeTek
                Informatics or PrimeUI.
            </p>
        </div>
    </section>
</Base>

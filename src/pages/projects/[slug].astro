---
import Base from '../../layouts/Base.astro';
import InlineCode from '../../components/InlineCode.astro';
import ProjectList from '../../components/ProjectList.astro';
import CopyCommand from '../../components/CopyCommand.astro';
import Icon from '../../components/Icon.astro';
import StatusTag from '../../components/openvue/StatusTag.vue';
import LinkButton from '../../components/openvue/LinkButton.vue';
import { projects, statusLabels } from '../../data/projects.js';
import { site } from '../../data/site.js';
import { getStats, formatCount } from '../../data/stats.js';

export function getStaticPaths() {
    return projects.map((project) => ({
        params: { slug: project.slug },
        props: { project }
    }));
}

const { project } = Astro.props;
const status = statusLabels[project.status];
const others = projects.filter((p) => p.slug !== project.slug);

const url = `${site.url}/projects/${project.slug}`;

const stats = await getStats();
const stars = stats.stars[project.githubRepo];
const downloads = stats.downloads[project.npmPackage];
// OpenVolt lives inside the OpenVue monorepo, so its stars are OpenVue's and
// the row has to say whose they are.
const repoName = project.githubRepo.split('/')[1];
const sharedRepo = repoName !== project.slug;

const schema = [
    {
        '@context': 'https://schema.org',
        '@type': 'SoftwareSourceCode',
        name: project.name,
        description: project.metaDescription,
        codeRepository: project.repo,
        programmingLanguage: project.language,
        runtimePlatform: project.language === 'Vue' ? 'Vue 3' : undefined,
        softwareVersion: project.version,
        license: 'https://opensource.org/licenses/MIT',
        url,
        isBasedOn: { '@type': 'SoftwareSourceCode', name: project.continues },
        maintainer: { '@id': `${site.url}/#organization` },
        author: { '@id': `${site.url}/#organization` },
        publisher: { '@id': `${site.url}/#organization` },
        isPartOf: { '@id': `${site.url}/#website` },
        // `keywords` states the terms this page competes on, which for a fork is
        // mostly the upstream name people are still searching for.
        keywords: [project.name, project.continues, `${project.continues} alternative`,
            `${project.continues} fork`, project.language]
    }
];
---

<Base
    title={`${project.name}: ${project.continues} continued`}
    description={project.metaDescription}
    image={`/og/${project.slug}.png`}
    schema={schema}
    breadcrumbs={[
        { name: 'Projects', path: '/projects' },
        { name: project.name, path: `/projects/${project.slug}` }
    ]}
>
    <section class="band hero hero-doc">
        <div class="wrap hero-grid hero-grid-doc">
            <div>
                <p class="breadcrumb"><a href="/projects">Projects</a> / {project.name}</p>

                <div class="page-head">
                    <h1>{project.name}</h1>
                    <StatusTag
                        version={project.version}
                        status={project.status}
                        label={status.label}
                        note={status.note}
                    />
                </div>
                <p class="lede">{project.tagline}</p>
                <p class="hero-summary">{project.summary}</p>

                <div class="button-row">
                    <LinkButton href={project.repo} label="Source" rel="noopener">
                        <Icon name="github" />
                    </LinkButton>
                    {project.docs && (
                        <LinkButton
                            href={project.docs}
                            label="Documentation"
                            severity="secondary"
                            outlined
                            rel="noopener"
                        />
                    )}
                    {project.npm && (
                        <LinkButton
                            href={project.npm}
                            label="npm"
                            severity="secondary"
                            text
                            rel="noopener"
                        />
                    )}
                </div>
            </div>

            {/* The facts a reader checks before adopting it, beside the pitch
                rather than in a table under it. */}
            <section class="board" aria-labelledby="facts-heading">
                <h2 id="facts-heading" class="board-title">At a glance</h2>
                <dl class="facts">
                    <div>
                        <dt>Status</dt>
                        <dd>{status.label}, v{project.version}</dd>
                    </div>
                    <div>
                        <dt>Continues</dt>
                        <dd>
                            {project.continues}
                            {(project.upstreamNote || project.upstreamStatus) && (
                                <span class="facts-note">
                                    {project.upstreamNote ?? `${project.upstreamStatus.toLowerCase()} upstream`}
                                </span>
                            )}
                        </dd>
                    </div>
                    <div>
                        <dt>License</dt>
                        <dd>{project.license}, permanently</dd>
                    </div>
                    <div>
                        <dt>Language</dt>
                        <dd>{project.language}</dd>
                    </div>
                    {stars != null && (
                        <div>
                            <dt>GitHub stars</dt>
                            <dd>
                                {formatCount(stars)}
                                {sharedRepo && <span class="facts-note">the {repoName} repository</span>}
                            </dd>
                        </div>
                    )}
                    {downloads != null && (
                        <div>
                            <dt>Downloads</dt>
                            <dd>
                                {formatCount(downloads)} last week
                                <span class="facts-note">{project.npmPackage}</span>
                            </dd>
                        </div>
                    )}
                </dl>
                {project.install && (
                    <div class="board-foot">
                        <span class="board-foot-label">Install</span>
                        <CopyCommand command={project.install} label="install command" />
                    </div>
                )}
            </section>
        </div>
    </section>

    {
        project.guides && (
            <section class="band" aria-labelledby="guides-heading">
                <div class="wrap">
                    <div class="section-head">
                        <h2 id="guides-heading">Guides</h2>
                    </div>
                    <ul class="card-grid">
                        {project.guides.map((guide) => (
                            <li>
                                <article class="card card-linked">
                                    <h3 class="card-title">
                                        <a href={guide.href}>{guide.title}</a>
                                    </h3>
                                    <p class="card-body">{guide.body}</p>
                                    <p class="card-foot">
                                        <span class="card-more" aria-hidden="true">
                                            {guide.cta} <Icon name="arrow-right" />
                                        </span>
                                    </p>
                                </article>
                            </li>
                        ))}
                    </ul>
                </div>
            </section>
        )
    }

    <section class="band band-subtle" aria-labelledby="highlights-heading">
        <div class="wrap">
            <div class="section-head">
                <h2 id="highlights-heading">What you get</h2>
            </div>
            <ul class="card-grid card-grid-2">
                {
                    project.highlights.map((h) => (
                        <li>
                            <article class="card">
                                <h3 class="card-title">{h.title}</h3>
                                <p class="card-body">
                                    <InlineCode text={h.body} />
                                </p>
                            </article>
                        </li>
                    ))
                }
            </ul>
        </div>
    </section>

    <section class="band" aria-labelledby="why-heading">
        <div class="wrap">
            <div class="prose">
                <h2 id="why-heading" class="section-title">Why this project exists</h2>
                {project.why.map((para) => (
                    <p>
                        <InlineCode text={para} />
                    </p>
                ))}
            </div>
        </div>
    </section>

    {
        project.packages.length > 0 && (
            <section class="band" aria-labelledby="packages-heading">
                <div class="wrap">
                    <div class="section-head">
                        <h2 id="packages-heading">Packages</h2>
                    </div>
                    <div class="table-scroll">
                        <table class="spec">
                            <thead>
                                <tr>
                                    <th scope="col">Package</th>
                                    <th scope="col">Responsibility</th>
                                </tr>
                            </thead>
                            <tbody>
                                {project.packages.map((pkg) => (
                                    <tr>
                                        <td class="spec-package">
                                            <code>{pkg.name}</code>
                                        </td>
                                        <td>{pkg.desc}</td>
                                    </tr>
                                ))}
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>
        )
    }

    <section class="band band-subtle" aria-labelledby="others-heading">
        <div class="wrap">
            <div class="section-head">
                <h2 id="others-heading">Other projects</h2>
            </div>
            <ProjectList items={others} heading="h3" />
        </div>
    </section>
</Base>

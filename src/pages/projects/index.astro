---
import Base from '../../layouts/Base.astro';
import ProjectList from '../../components/ProjectList.astro';
import FeatureCard from '../../components/openvue/FeatureCard.vue';
import { projects } from '../../data/projects.js';
import { site } from '../../data/site.js';

const description =
    'The three libraries the foundation maintains: OpenVue (PrimeVue continued), OpenIcons (PrimeIcons continued) and OpenUXKit (PrimeUIX continued).';

const schema = [
    {
        '@context': 'https://schema.org',
        '@type': 'CollectionPage',
        name: 'Projects',
        description,
        url: `${site.url}/projects`,
        isPartOf: { '@id': `${site.url}/#website` },
        mainEntity: {
            '@type': 'ItemList',
            itemListElement: projects.map((p, i) => ({
                '@type': 'ListItem',
                position: i + 1,
                name: p.name,
                description: p.metaDescription,
                url: `${site.url}/projects/${p.slug}`
            }))
        }
    },
    {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [
            { '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
            { '@type': 'ListItem', position: 2, name: 'Projects', item: `${site.url}/projects` }
        ]
    }
];
---

<Base title="Projects: OpenVue, OpenIcons, OpenUXKit" description={description} schema={schema}>
    <section class="hero prose">
        <h1>Projects</h1>
        <p class="lede">
            Three repositories, each one a maintained continuation of an archived upstream library.
            All MIT licensed, all versioned independently.
        </p>
    </section>

    <ProjectList items={projects} />

    <section aria-labelledby="fit-heading">
        <div class="section-head">
            <h2 id="fit-heading">How the pieces fit</h2>
            <p class="muted">
                Most applications only ever install OpenVue and a theme preset. The rest either
                comes in as a dependency or gets left out entirely.
            </p>
        </div>
        <ul class="feature-grid">
            <li>
                <FeatureCard title="OpenVue">
                    The component library you install. This is the only direct dependency most
                    projects need.
                </FeatureCard>
            </li>
            <li>
                <FeatureCard title="OpenUXKit">
                    The theming engine OpenVue renders with. Framework-agnostic, and usable on its
                    own.
                </FeatureCard>
            </li>
            <li>
                <FeatureCard title="OpenIcons">
                    The icon set. A dependency-free webfont, or Vue components if you want
                    tree-shaking.
                </FeatureCard>
            </li>
        </ul>
    </section>
</Base>
